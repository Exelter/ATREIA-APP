bin/
obj/
.vs/
*.user

# Real player traffic captures (logins, chat, etc.) -- never commit or sync these.
captures/
*.pcap
*.pcapng

# Build output of the release flow (dotnet publish -o publish, then the MSI into dist/).
publish/
dist/
# Tools/release/build-release.ps1: its working folder and the release it builds
release-work/
releases/

node_modules/
.claude/settings.local.json

# Working notes from content derivation (third-party prose, never checked in)
*.review.json

__pycache__/

# Generated translation spreadsheets for native speakers (Tools/translations/export_translations.py)
Tools/translations/export/

# The game's pictures (NCSOFT's artwork: item, skill, pet and boss icons, maps, class and race emblems) are not kept in this public repository.
# The app downloads them once as an image pack from atreia.app instead; a copy unpacked here for a local build stays out of git.
Client/assets/aion2/**/*.png
Client/assets/aion2/**/*.jpg
Client/assets/aion2/**/*.webp
Client/assets/classes/icons/
Client/assets/races/icons/
